#!/bin/bash
set -euo pipefail
unset GZIP TAR_OPTIONS

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
version=$(bash -c 'source "$1"; printf "%s" "$pkgver"' bash "$root/packaging/arch/PKGBUILD")
archive="$root/packaging/arch/gsr-replay-$version.tar.gz"
files=(
  AGENTS.md CHANGELOG.md CONTRIBUTING.md LICENSE README.md SECURITY.md
  bin/gsr-replay bin/gsr-replay-callback install.sh uninstall.sh
  systemd/gsr-replay.service systemd/gsr-replay-archive.service
  systemd/gsr-replay-archive.timer systemd/gsr-replay-audio-monitor.service tests/run.sh
  packaging/arch/create-source-archive packaging/arch/gsr-replay.install
  packaging/arch/gsr-replay.service packaging/arch/gsr-replay-archive.service
  packaging/arch/gsr-replay-archive.timer packaging/arch/gsr-replay-audio-monitor.service
)

temp=$(mktemp "$archive.XXXXXX")
trap 'rm -f "$temp"' EXIT
tar -C "$root" --format=ustar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner \
  --transform "s,^,gsr-replay-$version/," -cf - "${files[@]}" | gzip -n -9 >"$temp"
mv "$temp" "$archive"
trap - EXIT
sha256sum "$archive"
