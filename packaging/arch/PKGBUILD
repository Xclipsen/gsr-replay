# Maintainer: Xclipsen <101043764+Xclipsen@users.noreply.github.com>
pkgname=gsr-replay
pkgver=1.1.0
pkgrel=1
pkgdesc="Instant replay onboarding and service for GPU Screen Recorder"
arch=('any')
url="https://github.com/Xclipsen/gsr-replay"
license=('MIT')
depends=('bash' 'coreutils' 'diffutils' 'ffmpeg' 'gpu-screen-recorder' 'systemd' 'util-linux')
optdepends=('libnotify: desktop save notifications'
            'waybar: replay status and click controls')
checkdepends=('shellcheck')
install=gsr-replay.install
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
        "$install")
sha256sums=('214c7465deb3736de90a30a995f2bcd1f276e38ed6227c3ea807512888c0435a'
            '5526ea1a026587dcfcf9d4d204a46f4d0e7b21109e5092a335902001a362ce31')

check() {
  bash -n "$srcdir/$install"
  shellcheck "$srcdir/$install"
  cd "$srcdir/$pkgname-$pkgver"

  bash -n bin/* install.sh uninstall.sh tests/run.sh
  shellcheck bin/* install.sh uninstall.sh tests/run.sh
  bash tests/run.sh
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 bin/gsr-replay "$pkgdir/usr/bin/gsr-replay"
  install -Dm755 bin/gsr-replay-callback "$pkgdir/usr/lib/gsr-replay/gsr-replay-callback"
  install -Dm644 packaging/arch/gsr-replay.service "$pkgdir/usr/lib/systemd/user/gsr-replay.service"
  install -Dm644 packaging/arch/gsr-replay-archive.service "$pkgdir/usr/lib/systemd/user/gsr-replay-archive.service"
  install -Dm644 packaging/arch/gsr-replay-archive.timer "$pkgdir/usr/lib/systemd/user/gsr-replay-archive.timer"
  install -Dm644 packaging/arch/gsr-replay-audio-monitor.service "$pkgdir/usr/lib/systemd/user/gsr-replay-audio-monitor.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
